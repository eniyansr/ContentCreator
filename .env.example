# ============================================
# CreatorAI - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================

# Database Configuration (WAMPServer64)
DB_HOST=localhost
DB_NAME=creator_ai
DB_USER=root
DB_PASSWORD=

# Application Settings
APP_NAME=CreatorAI
APP_URL=http://localhost/myworkouts/contentcreators
APP_ENV=development
APP_DEBUG=true

# AI Provider Configuration
# Supported: openai, gemini
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Python AI Service
PYTHON_AI_URL=http://127.0.0.1:8000
PYTHON_AI_SECRET=change_this_to_a_random_secret_key_123

# Admin Registration Key
# Required to create admin accounts
ADMIN_REGISTRATION_KEY=CreatorAI_Admin_2024_SecretKey

# Session Configuration
SESSION_LIFETIME=7200
SESSION_NAME=creatorai_session

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=uploads/

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900
MAX_AI_REQUESTS_PER_HOUR=100

# Logging
LOG_DIR=logs/
LOG_LEVEL=debug
